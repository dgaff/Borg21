AboutBox DIALOG 22, 17, 203, 92
STYLE DS_MODALFRAME | WS_CAPTION | WS_SYSMENU
CAPTION "About Borg"
{
 CTEXT "BORG", -1, 29, 5, 144, 8
 CTEXT "A distributed learning classifier system simulation", -1, 6, 29, 191, 8
 CTEXT "Version 2.1", -1, 29, 55, 144, 8
 DEFPUSHBUTTON "OK", IDOK, 85, 72, 32, 14, WS_GROUP
 CTEXT "Basic Organized Robot Group", -1, 51, 14, 100, 8
 CTEXT "environment by Doug Gaff", -1, 49, 40, 105, 8
}

BorgIcon ICON "borg.ico"


DisplaySettings DIALOG 120, 73, 210, 159
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Display Settings"
FONT 8, "MS Sans Serif"
{
 GROUPBOX "Environment Display", IDC_DISPLAYenv, 15, 10, 80, 50, BS_GROUPBOX
 CONTROL "During Iteration", IDC_DISPLAYenvDuring, "BUTTON", BS_AUTORADIOBUTTON | WS_GROUP, 25, 25, 60, 12
 CONTROL "After Iteration", IDC_DISPLAYenvAfter, "BUTTON", BS_AUTORADIOBUTTON, 25, 40, 60, 12
 GROUPBOX "Axes Display", IDC_DISPLAYaxes, 114, 10, 80, 50, BS_GROUPBOX
 CONTROL "On", IDC_DISPLAYaxesOn, "BUTTON", BS_AUTORADIOBUTTON | WS_GROUP, 125, 25, 60, 12
 CONTROL "Off", IDC_DISPLAYaxesOff, "BUTTON", BS_AUTORADIOBUTTON, 125, 40, 60, 12
 GROUPBOX "Information Display", IDC_DISPLAYinfo, 15, 70, 80, 50, BS_GROUPBOX
 CONTROL "During Iteration", IDC_DISPLAYinfoDuring, "BUTTON", BS_AUTORADIOBUTTON | WS_GROUP, 25, 85, 60, 12
 CONTROL "After Iteration", IDC_DISPLAYinfoAfter, "BUTTON", BS_AUTORADIOBUTTON, 25, 100, 60, 12
 GROUPBOX "Object Display", IDC_DISPLAYobject, 114, 70, 80, 50, BS_GROUPBOX
 CONTROL "To Scale", IDC_DISPLAYobjectToScale, "BUTTON", BS_AUTORADIOBUTTON | WS_GROUP, 125, 85, 60, 12
 CONTROL "Not To Scale", IDC_DISPLAYobjectNotToScale, "BUTTON", BS_AUTORADIOBUTTON, 125, 100, 60, 12
 DEFPUSHBUTTON "OK", IDOK, 30, 134, 50, 14
 PUSHBUTTON "Cancel", IDCANCEL, 130, 134, 50, 14
}

