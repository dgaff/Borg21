#include<borg.h>

MainMenu MENU 
{
 POPUP "&File"
 {
  MENUITEM "&New", IDM_FILEnew
  MENUITEM "&Open...", IDM_FILEopen
  MENUITEM "&Walk...", IDM_FILEwalk
  MENUITEM "&Save", IDM_FILEsave
  MENUITEM "Save &as...", IDM_FILEsaveAs
  MENUITEM SEPARATOR
  MENUITEM "Save &Meta File...", IDM_FILEsaveMeta
  MENUITEM SEPARATOR
  MENUITEM "&Load Rules", IDM_FILEloadRules
  MENUITEM "Save &Rules", IDM_FILEsaveRules
  MENUITEM SEPARATOR
  MENUITEM "Save Posi&tions in ASCII", IDM_FILEsavePositions
  MENUITEM "Save Positions in &Binary", IDM_FILEsavePositionsBin
  MENUITEM SEPARATOR
  MENUITEM "E&xit", IDM_FILEexit
 }

 POPUP "&Simulate"
 {
  MENUITEM "&Run", IDM_SIMULATErun
  MENUITEM "&Step", IDM_SIMULATEstep
  MENUITEM "S&top", IDM_SIMULATEstop
  MENUITEM "Reset &All", IDM_SIMULATEreset
  MENUITEM "Reset &Environment", IDM_SIMULATEresetEnv
  MENUITEM "Start &Batch", IDM_SIMULATEstartBatch
 }

 POPUP "&Options"
 {
  MENUITEM "&Display...", IDM_OPTIONSdisplay
  MENUITEM "&System...", IDM_OPTIONSenvironment
  MENUITEM "&Agent...", IDM_OPTIONSagent
  MENUITEM "&Network...", IDM_OPTIONSnetwork
 }

 POPUP "&Help"
 {
  MENUITEM "&About...", IDM_HELPabout
 }

}


